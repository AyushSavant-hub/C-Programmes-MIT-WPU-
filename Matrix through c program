#include <stdio.h>

void displayMatrix(int rows, int cols, int mat[10][10]) {
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            printf("%d\t", mat[i][j]);
        }
        printf("\n");
    }
}

int main() {
    int r, c, i, j, k;
    int A[10][10], B[10][10], sum[10][10];
    printf("Enter number of rows and columns: ");
    scanf("%d %d", &r, &c);
    printf("Enter elements of matrix A:\n");
    for (i = 0; i < r; i++)
        for (j = 0; j < c; j++)
            scanf("%d", &A[i][j]);

    printf("Enter elements of matrix B:\n");
    for (i = 0; i < r; i++)
        for (j = 0; j < c; j++)
            scanf("%d", &B[i][j]);
    printf("\n--- Matrix Addition Result ---\n");
    for (i = 0; i < r; i++) {
        for (j = 0; j < c; j++) {
            sum[i][j] = A[i][j] + B[i][j];
            printf("%d\t", sum[i][j]);
        }
        printf("\n");
    }
    printf("\n--- Finding Saddle Point in Matrix A ---\n");
    int foundSaddle = 0;
    for (i = 0; i < r; i++) {
        int min_row = A[i][0], col_ind = 0;
        for (j = 1; j < c; j++) {
            if (min_row > A[i][j]) {
                min_row = A[i][j];
                col_ind = j;
            }
        }
        int isSaddle = 1;
        for (k = 0; k < r; k++) {
            if (min_row < A[k][col_ind]) {
                isSaddle = 0;
                break;
            }
        }
        if (isSaddle) {
            printf("Saddle Point found: %d at (%d, %d)\n", min_row, i, col_ind);
            foundSaddle = 1;
        }
    }
    if (!foundSaddle) printf("No saddle point found.\n");

    if (r == 2 && c == 2) {
        printf("\n--- Inverse of Matrix A (2x2) ---\n");
        float det = (A[0][0] * A[1][1]) - (A[0][1] * A[1][0]);
        if (det == 0) {
            printf("No inverse possible (Determinant is 0).\n");
        } else {
            printf("Inverse Matrix:\n");
            printf("%.2f\t%.2f\n", A[1][1] / det, -A[0][1] / det);
            printf("%.2f\t%.2f\n", -A[1][0] / det, A[0][0] / det);
        }
    }
    if (r == c) {
        printf("\n--- Checking Magic Square (Matrix A) ---\n");
        int targetSum = 0, isMagic = 1;
        for (j = 0; j < c; j++) targetSum += A[0][j];
        for (i = 0; i < r; i++) {
            int rowSum = 0, colSum = 0;
            for (j = 0; j < c; j++) {
                rowSum += A[i][j];
                colSum += A[j][i];
            }
            if (rowSum != targetSum || colSum != targetSum) isMagic = 0;
        }
        int diag1 = 0, diag2 = 0;
        for (i = 0; i < r; i++) {
            diag1 += A[i][i];
            diag2 += A[i][r - 1 - i];
        }
        if (diag1 != targetSum || diag2 != targetSum) isMagic = 0;

        if (isMagic) printf("Matrix A is a Magic Square!\n");
        else printf("Matrix A is NOT a magic square.\n");
    }
    return 0;

}

