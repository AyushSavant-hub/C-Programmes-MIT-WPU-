#include <stdio.h>

int main() {
    char str1[100], str2[100], rev[100], sub[100];
    int i, j, len = 0, len2 = 0, isPalindrome = 1, isEqual = 1, found = 0;
    printf("Enter the first string: ");
    scanf("%s", str1);
    while (str1[len] != '\0') {
        len++;
    }
    printf("Length of string: %d\n", len);
    for (i = 0; i < len; i++) {
        rev[i] = str1[len - 1 - i];
    }
    rev[len] = '\0';
    printf("Reversed string: %s\n", rev);
    printf("\nEnter second string for comparison: ");
    scanf("%s", str2);
    i = 0;
    while (str1[i] != '\0' || str2[i] != '\0') {
        if (str1[i] != str2[i]) {
            isEqual = 0;
            break;
        }
        i++;
    }
    if (isEqual) printf("Strings are equal.\n");
    else printf("Strings are not equal.\n");
    for (i = 0; i < len; i++) {
        if (str1[i] != str1[len - 1 - i]) {
            isPalindrome = 0;
            break;
        }
    }
    if (isPalindrome) printf("The string is a palindrome.\n");
    else printf("The string is not a palindrome.\n");
    printf("\nEnter a substring to search for: ");
    scanf("%s", sub);
    while (sub[len2] != '\0') len2++;
    for (i = 0; i <= len - len2; i++) {
        for (j = 0; j < len2; j++) {
            if (str1[i + j] != sub[j]) break;
        }
        if (j == len2) {
            found = 1;
            break;
        }
    }
    if (found) printf("Substring found!\n");
    else printf("Substring not found.\n");
    return 0;
}

