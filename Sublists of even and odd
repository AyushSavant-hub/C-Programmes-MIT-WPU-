#include <stdio.h>
int main() {
    int n, i;
    int arr[100], even[100], odd[100];
    int evenCount = 0, oddCount = 0;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    printf("Enter %d integers:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    for (i = 0; i < n; i++) {
        if (arr[i] % 2 == 0) {
            even[evenCount] = arr[i];
            evenCount++;
        } else {
            odd[oddCount] = arr[i];
            oddCount++;
        }
    }
    printf("\nEven numbers: ");
    for (i = 0; i < evenCount; i++) {
        printf("%d ", even[i]);
    }
    printf("\nOdd numbers: ");
    for (i = 0; i < oddCount; i++) {
        printf("%d ", odd[i]);
    }
    return 0;}

