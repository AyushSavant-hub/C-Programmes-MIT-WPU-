#include <stdio.h>
int main() {
    int n ,temp ,digit,sum= 0;
    float result = 0.0;
    printf("Enter an number: ");
    scanf("%d", &n);
    temp=n;
    sum=0;
    while(temp>0){
        digit=temp%10;
        sum+=(digit*digit*digit);
        temp=temp/10;}
    if (sum==n){
        printf("%d is an Armstrong number.\n", n);}
    else{
        printf("%d is not an Armstrong number.\n", n);}
        return 0;
}
