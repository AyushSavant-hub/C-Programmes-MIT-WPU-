#include <stdio.h>
#include <math.h>

void checkPrime(int num);
long long getFactorial(int num);
void getPrimeFactors(int num);
int main() {
    int choice, num;

    printf("Enter an integer: ");
    scanf("%d", &num);

    printf("\n--- Choose an Operation ---\n");
    printf("1. Square Root\n");
    printf("2. Square\n");
    printf("3. Cube\n");
    printf("4. Prime or Not\n");
    printf("5. Factorial\n");
    printf("6. Prime Factors\n");
    printf("Enter your choice (1-6): ");
    scanf("%d", &choice);

    switch (choice) {
        case 1:
            if (num < 0) printf("Square root of negative numbers is imaginary.\n");
            else printf("Square root of %d is %.2f\n", num, sqrt(num));
            break;
        case 2:
            printf("Square of %d is %d\n", num, num * num);
            break;
        case 3:
            printf("Cube of %d is %d\n", num, num * num * num);
            break;
        case 4:
            checkPrime(num);
            break;
        case 5:
            if (num < 0) printf("Factorial of negative numbers is undefined.\n");
            else printf("Factorial of %d is %lld\n", num, getFactorial(num));
            break;
        case 6:
            getPrimeFactors(num);
            break;
        default:
            printf("Invalid choice!\n");
    }
    return 0;
}
void checkPrime(int num) {
    int i, isPrime = 1;
    if (num <= 1) isPrime = 0;
    for (i = 2; i <= sqrt(num); i++) {
        if (num % i == 0) {
            isPrime = 0;
            break;
        }
    }
    if (isPrime) printf("%d is a Prime number.\n", num);
    else printf("%d is not a Prime number.\n", num);
}
long long getFactorial(int num) {
    if (num == 0 || num == 1) return 1;
    return num * getFactorial(num - 1);
}
void getPrimeFactors(int num) {
    printf("Prime factors of %d are: ", num);
    while (num % 2 == 0) {
        printf("2 ");
        num /= 2;
    }
    for (int i = 3; i <= sqrt(num); i += 2) {
        while (num % i == 0) {
            printf("%d ", i);
            num /= i;
        }
    }
    if (num > 2) printf("%d", num);
    printf("\n");
}

    
